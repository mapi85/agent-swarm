# --- Backend v2 -------------------------------------------------------------
# Copier vers .env (la stack v2 lit les mêmes fichiers que la v1, variables distinctes)

# Mot de passe PostgreSQL (service db du docker-compose.v2.yml)
POSTGRES_PASSWORD=

# URL de connexion — inutile en Docker (surchargée par le compose) ;
# en dev natif : postgresql+psycopg://swarm:<mdp>@127.0.0.1:5433/swarm
# DATABASE_URL=

# Clé Fernet pour le chiffrement des secrets en base (OBLIGATOIRE).
# Générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

LOG_LEVEL=INFO
