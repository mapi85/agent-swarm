# --- API Anthropic (obligatoire) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Modèle par défaut des nouveaux agents ---
DEFAULT_MODEL=claude-opus-4-8
DEFAULT_EFFORT=high

# Les providers LLM (Anthropic ou compatible, OpenAI ou compatible — types,
# URL, clés, provider par défaut, rattachement par agent) se gèrent dans
# l'onglet Réglages du tableau de bord, pas ici. ANTHROPIC_API_KEY ci-dessus
# reste la clé utilisée par le provider Anthropic initial si sa clé est vide.

# --- Garde-fous ---
DEFAULT_MAX_ITERATIONS=60
MAX_CONCURRENT_SESSIONS=4
SHELL_TIMEOUT_DEFAULT=300
SHELL_TIMEOUT_MAX=1800

# Budget de tokens par session (cumul in+out ; 0 = illimité), surchargeable par agent
DEFAULT_SESSION_TOKEN_BUDGET=0

# Sous-agents en contexte (fan-out rapide, modèle économique)
SUBAGENT_MODEL=claude-haiku-4-5
SUBAGENT_MAX_ITERATIONS=8

# Détection de stagnation (arrêt d'une session qui boucle)
MAX_CONSECUTIVE_TOOL_ERRORS=6
MAX_REPEAT_TOOL_CALLS=4

# Gestion du contexte
TOOL_RESULT_MAX_CHARS=12000
CONTEXT_TRIM_THRESHOLD=150000
CONTEXT_KEEP_LAST=8

# --- Sécurité ---
# Allowlist e-mail : domaines/adresses autorisés, séparés par des virgules (vide = tout permis)
EMAIL_ALLOWLIST=
# Motifs shell interdits (regex, séparés par « ;;; ») ; laisser vide pour autoriser le défaut intégré

# --- SMTP (envoi de mails par les agents, optionnel) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
